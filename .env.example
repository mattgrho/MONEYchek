# --- Runtime -----------------------------------------------------------------
# NODE_ENV: development | test | production
NODE_ENV=development
# Port the single public server process listens on (Replit injects PORT).
PORT=5000
# Canonical public origin of THIS deployment. All security-sensitive URLs
# (invitation links, document links) are derived from this value, never from
# request Host headers. Example: https://books.example.com
APP_BASE_URL=http://localhost:5000

# --- Database ----------------------------------------------------------------
# Runtime application connection (least-privileged role in production).
DATABASE_URL=
# Disposable test database. Must NOT equal DATABASE_URL. Integration tests
# refuse to run without it and refuse production-looking targets.
TEST_DATABASE_URL=
# Privileged connection used ONLY by `npm run db:migrate` as an explicit,
# human-triggered release step. Falls back to DATABASE_URL in development.
MIGRATION_DATABASE_URL=

# --- Deployment binding --------------------------------------------------------
# single_company is the only supported mode in Prototype Core.
DEPLOYMENT_MODE=single_company
# Optional cross-check: after bootstrap, set to the primary organization id to
# fail closed if the database and environment ever disagree.
PRIMARY_ORGANIZATION_ID=
# The verified email address allowed to claim this deployment as owner.
# Required until bootstrap has completed.
BOOTSTRAP_OWNER_EMAIL=

# --- Authentication ------------------------------------------------------------
# AUTH_PROVIDER=local  -> built-in email+password accounts (no external
#   identity service): scrypt password hashes, server-side sessions in an
#   httpOnly cookie, registration closed to the bootstrap owner email and
#   invitation tokens. Change-password revokes other sessions. No MFA and no
#   self-service password reset (an operator runbook covers a forgotten
#   owner password; see README).
# AUTH_PROVIDER unset  -> Clerk when both keys below are set; otherwise the
#   app runs in "auth not configured" state: it serves a setup notice and
#   refuses all authenticated APIs. There is no fallback login.
AUTH_PROVIDER=

# Clerk keys (only used when AUTH_PROVIDER is unset or "clerk")
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Logging -------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- File storage ---------------------------------------------------------------
# Replit App Storage bucket for private attachments in production.
# Development uses a local .attachments-dev directory; tests use an isolated
# per-run directory. Production fails closed when unset (attachments hidden).
APP_STORAGE_BUCKET_ID=

# --- Email (optional) ------------------------------------------------------------
# When EMAIL_PROVIDER is empty, no email is ever "sent"; documents are always
# downloadable and outbound messages stay in the outbox as previews.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# --- Jobs ----------------------------------------------------------------------
# Shared secret required by the scheduled-job runner entry point.
SCHEDULED_JOB_SECRET=
